FROM docker.io/library/node:lts-bookworm-slim@sha256:5df79989ed685e09f0a98019db4cebfb22fb9df1a53c0161664a011f7ff6b0f1 AS node

FROM docker.io/library/buildpack-deps:26.10@sha256:6293c257b0fbcd30ba8142f7991d15f93228df6f4877a2ee141aee7281ba4ff8

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install --no-install-recommends --yes \
        buildah \
        fuse-overlayfs \
        gettext-base \
        podman \
    && git config --system --add safe.directory '*' \
    && apt-get dist-clean \
    && rm -rf /var/cache/* /var/log/* /tmp/*

ENV DEPLOYMENT_BASEPATH=/opt/runner \
    IMAGE_OS=ubuntu26 \
    ImageOS=ubuntu26 \
    LSB_OS_VERSION=2604 \
    LSB_RELEASE=26.04 \
    RUNNER_USER=root \
    USER=root

COPY --chmod=644 containers.conf storage.conf /etc/containers/
VOLUME /var/tmp
VOLUME /var/lib/containers

ENV AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache \
    RUNNER_TOOL_CACHE=/opt/hostedtoolcache
RUN mkdir -m 0777 -p /opt/hostedtoolcache
VOLUME /opt/hostedtoolcache

RUN mkdir -p /var/lib/shared/overlay-images \
             /var/lib/shared/overlay-layers \
             /var/lib/shared/vfs-images \
             /var/lib/shared/vfs-layers && \
    touch /var/lib/shared/overlay-images/images.lock && \
    touch /var/lib/shared/overlay-layers/layers.lock && \
    touch /var/lib/shared/vfs-images/images.lock && \
    touch /var/lib/shared/vfs-layers/layers.lock

COPY --from=node /usr/local/bin/node /usr/local/bin/node
