{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["mikejovyan"],
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/images/.*/Dockerfile$/"],
      "matchStrings": [
        "# renovate:(?:\\s+depName=(?<depName>[^\\s]+))?(?:\\s+datasource=(?<datasource>[^\\s]+))?(?:\\s+extractVersion=(?<extractVersion>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\nARG [A-Z_]+=(?<currentValue>[\\d.]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "commitMessageTopic": "{{datasource}}/{{depName}}",
      "extractVersion": "^v?(?<version>.*)",
      "matchManagers": ["custom.regex"]
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "commitMessageTopic": "{{replace 'https://data.forgejo.org/' '' depName}} action"
    }
  ],
  "platformAutomerge": true,
  "prHourlyLimit": 0,
  "semanticCommitScope": null,
  "semanticCommits": "enabled"
}
