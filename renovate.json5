{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  assignees: [ "mikejovyan" ],
  extends: [
    "local>renovate-bot/renovate_config",
    "customManagers:dockerfileVersions",
  ],
  packageRules: [
    {
      matchFileNames: [ "images/forgejo-runner-engine/Dockerfile" ],
      matchPackageNames: [ "quay.io/podman/stable" ],
      automerge: false,
    },
  ],
}
